<script>
  (function initPayoutLensDashboard() {
    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const canHover = window.matchMedia('(hover: hover)').matches;

    // Elements
    const heroRateCard = document.getElementById('hero-rate-card');
    const heroRateCounter = document.getElementById('hourly-rate-counter');
    const flipTarget = document.getElementById('rate-flip-target');
    const dynamicSentence = document.getElementById('dynamic-summary-sentence');
    const rateSublabel = document.getElementById('rate-sublabel');
    const simBadge = document.getElementById('simulator-state-chip');
    const cardNetFuel = document.getElementById('card-net-fuel');
    const cardTakeHome = document.getElementById('card-take-home');
    const cardActiveHours = document.getElementById('card-active-hours');
    const heroImg = document.getElementById('hero-img');
    const heroViewport = document.getElementById('hero-viewport');
    const emptyStateCard = document.getElementById('empty-state-card');
    const dashboardDataZone = document.getElementById('dashboard-data-zone');
    const simToggles = [
      document.getElementById('sim-toggle-1'),
      document.getElementById('sim-toggle-2'),
      document.getElementById('sim-toggle-3')
    ];
    const resetSimBtn = document.getElementById('reset-sim-btn');
    const applyRecBtn = document.getElementById('apply-recommendation-btn');

    // Baseline Data (exact match)
    const BASE_NET = 18000;
    const BASE_HOURS = 85.0;
    const BASE_RATE = Math.round(BASE_NET / BASE_HOURS); // 212

    // Check URL for empty state (?empty=1)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('empty') === '1') {
      if (dashboardDataZone) dashboardDataZone.classList.add('hidden');
      if (emptyStateCard) {
        emptyStateCard.classList.remove('hidden');
        emptyStateCard.classList.add('flex');
      }
      if (heroRateCounter) heroRateCounter.textContent = '₹—';
      if (dynamicSentence) dynamicSentence.textContent = 'Statements awaiting upload. Connect files or paste weekly summaries to uncover your true hourly payout.';
      return;
    }

    // 1. Hero entrance and Parallax (only if motion preferred)
    if (!isReducedMotion && heroImg) {
      heroImg.style.transform = 'scale(1.05)';
      setTimeout(() => {
        heroImg.style.transition = 'transform 1.2s cubic-bezier(0.16, 1, 0.3, 1)';
        heroImg.style.transform = 'scale(1)';
      }, 50);

      window.addEventListener('scroll', () => {
        const scrolled = window.scrollY;
        if (scrolled < 500) {
          heroImg.style.transform = `translateY(${scrolled * 0.3}px) scale(1)`;
        }
      }, { passive: true });
    }

    // 2. Count-up for Hero Hourly Rate Card
    function animateCounter(targetValue, duration = 1000) {
      if (isReducedMotion) {
        heroRateCounter.textContent = '₹' + targetValue;
        return;
      }
      const start = 0;
      const startTime = performance.now();

      function update(now) {
        const elapsed = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const easeVal = 1 - (1 - progress) * (1 - progress);
        const current = Math.floor(start + (targetValue - start) * easeVal);
        heroRateCounter.textContent = '₹' + current;
        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          heroRateCounter.textContent = '₹' + targetValue;
        }
      }
      requestAnimationFrame(update);
    }

    if (!isReducedMotion) {
      animateCounter(BASE_RATE, 1000);
    } else {
      heroRateCounter.textContent = '₹' + BASE_RATE;
    }

    // 3. Stagger & Mouse tracking Spotlight for Cards
    const interactiveCards = document.querySelectorAll('.interactive-card');
    interactiveCards.forEach((card, index) => {
      if (!isReducedMotion) {
        card.style.opacity = '0';
        card.style.transform = 'translateY(12px)';
        setTimeout(() => {
          card.style.transition = 'opacity 600ms cubic-bezier(0.16, 1, 0.3, 1), transform 600ms cubic-bezier(0.16, 1, 0.3, 1)';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0px)';
        }, 120 + index * 80);
      }

      if (canHover) {
        const spotlight = card.querySelector('.card-radial-spotlight');
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          if (spotlight) {
            spotlight.style.background = `radial-gradient(circle 220px at ${x}px ${y}px, rgba(21, 88, 201, 0.22), transparent 75%)`;
          }
        });
      }
    });

    // 4. Breakdown Chart Animated Bars Reveal
    const animatedBars = document.querySelectorAll('.chart-animated-bar');
    function triggerBarAnimations() {
      animatedBars.forEach((bar) => {
        const target = bar.getAttribute('data-target-width');
        bar.style.transition = isReducedMotion ? 'none' : 'width 900ms cubic-bezier(0.16, 1, 0.3, 1)';
        bar.style.width = target;
      });
    }

    if (!isReducedMotion && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            triggerBarAnimations();
            observer.disconnect();
          }
        });
      }, { threshold: 0.1 });
      const firstBar = document.querySelector('.chart-animated-bar');
      if (firstBar) observer.observe(firstBar);
    } else {
      triggerBarAnimations();
    }

    // 7. Interactive What-If Simulator Logic
    function recalculateProjection() {
      let projectedNet = BASE_NET;
      let projectedHours = BASE_HOURS;
      let changesActive = false;

      // Toggle 1: Shift 6 hrs from Evening (142) to Lunch (268) => + (268 - 142)*6 = +756
      if (simToggles[0] && simToggles[0].checked) {
        projectedNet += 756;
        changesActive = true;
      }

      // Toggle 2: Reduce Night idle waiting by 2 hrs => hours - 2
      if (simToggles[1] && simToggles[1].checked) {
        projectedHours -= 2.0;
        changesActive = true;
      }

      // Toggle 3: Skip zero-incentive shifts => petrol saved + ₹320, reduced hours by 3
      if (simToggles[2] && simToggles[2].checked) {
        projectedNet += 320;
        projectedHours -= 3.0;
        changesActive = true;
      }

      const calculatedRate = Math.round(projectedNet / projectedHours);

      if (!isReducedMotion && flipTarget) {
        flipTarget.style.transition = 'transform 250ms ease-in, opacity 250ms ease';
        flipTarget.style.transform = 'rotateY(90deg)';
        setTimeout(() => {
          heroRateCounter.textContent = '₹' + calculatedRate;
          cardNetFuel.textContent = '₹' + projectedNet.toLocaleString('en-IN');
          cardActiveHours.textContent = projectedHours.toFixed(1) + ' hrs';
          
          if (changesActive) {
            simBadge.classList.remove('hidden');
            rateSublabel.innerHTML = `<span class="material-symbols-outlined text-[12px] text-[#D4FF24]">model_training</span> Projected: ${projectedHours.toFixed(1)} hrs with simulated optimizations`;
            dynamicSentence.innerHTML = `Projected earnings: <strong class="text-on-surface font-semibold">₹${projectedNet.toLocaleString('en-IN')}</strong>. Net yield lifts to <strong class="text-[#D4FF24] font-semibold underline decoration-[#D4FF24]/40 underline-offset-4">₹${calculatedRate} an hour</strong> (+₹${calculatedRate - BASE_RATE}/hr advantage).`;
          } else {
            simBadge.classList.add('hidden');
            rateSublabel.innerHTML = `<span class="material-symbols-outlined text-[12px] text-outline">tune</span> After fuel and platform fees, across 85.0 verified hours`;
            dynamicSentence.innerHTML = `You earned <strong class="text-on-surface font-semibold">₹18,000</strong> this week. After fuel, that's <strong class="text-[#D4FF24] font-semibold underline decoration-[#D4FF24]/40 underline-offset-4">₹212 an hour</strong>.`;
          }

          flipTarget.style.transition = 'transform 300ms ease-out, opacity 300ms ease';
          flipTarget.style.transform = 'rotateY(0deg)';
        }, 250);
      } else {
        heroRateCounter.textContent = '₹' + calculatedRate;
        cardNetFuel.textContent = '₹' + projectedNet.toLocaleString('en-IN');
        cardActiveHours.textContent = projectedHours.toFixed(1) + ' hrs';
        if (changesActive) {
          simBadge.classList.remove('hidden');
          rateSublabel.innerHTML = `<span class="material-symbols-outlined text-[12px] text-[#D4FF24]">model_training</span> Projected: ${projectedHours.toFixed(1)} hrs with simulated optimizations`;
          dynamicSentence.innerHTML = `Projected earnings: <strong class="text-on-surface font-semibold">₹${projectedNet.toLocaleString('en-IN')}</strong>. Net yield lifts to <strong class="text-[#D4FF24] font-semibold underline decoration-[#D4FF24]/40 underline-offset-4">₹${calculatedRate} an hour</strong>.`;
        } else {
          simBadge.classList.add('hidden');
          rateSublabel.innerHTML = `<span class="material-symbols-outlined text-[12px] text-outline">tune</span> After fuel and platform fees, across 85.0 verified hours`;
          dynamicSentence.innerHTML = `You earned <strong class="text-on-surface font-semibold">₹18,000</strong> this week. After fuel, that's <strong class="text-[#D4FF24] font-semibold underline decoration-[#D4FF24]/40 underline-offset-4">₹212 an hour</strong>.`;
        }
      }
    }

    simToggles.forEach(toggle => {
      if (toggle) toggle.addEventListener('change', recalculateProjection);
    });

    if (resetSimBtn) {
      resetSimBtn.addEventListener('click', () => {
        simToggles.forEach(toggle => { if (toggle) toggle.checked = false; });
        recalculateProjection();
      });
    }

    if (applyRecBtn) {
      applyRecBtn.addEventListener('click', () => {
        const toggle1 = simToggles[0];
        if (toggle1) {
          toggle1.checked = true;
          recalculateProjection();
          document.getElementById('simulator-section').scrollIntoView({ behavior: 'smooth' });
        }
      });
    }

  })();
</script></body></html>